      "examples": [
        {
          "source": "open-dictionary:v2.0",
          "text": "Plants use sunlight for photosynthesis.",
          "translation": "植物利用阳光进行光合作用。"
        },
        {
          "source": "open-dictionary:v2.0",
          "text": "Photosynthesis converts light energy into chemical energy.",
          "translation": "光合作用把光能转化为化学能。"
        }
